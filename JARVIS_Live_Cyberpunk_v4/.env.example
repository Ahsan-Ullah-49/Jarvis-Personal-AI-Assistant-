# Set these as Vercel Environment Variables for the deployed application.
# Without these values the UI runs in clearly-labeled DEMO MODE.

# REQUIRED for private live use. Choose a unique, long owner passcode.
JARVIS_APP_PASSCODE=

# REQUIRED for session signing. Use at least 32 random characters, different from the passcode.
JARVIS_SESSION_SECRET=

# REQUIRED after fixing your n8n AI workflow. Use PUBLISHED production webhook, not /webhook-test/.
N8N_WEBHOOK_URL=

# Configure n8n Webhook node Header Authentication to require X-Assistant-Key,
# then put its secret value here. Never prefix it with NEXT_PUBLIC_ or commit it.
N8N_HEADER_AUTH_SECRET=
